{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "outFiles": [
                "${workspaceFolder}/client/dist/**/*.js"
            ]
        },
        {
            "name": "Debug Server",
            "type": "debugpy",
            "request": "launch",
            "module": "idfkit_lsp",
            "justMyCode": false
        }
    ]
}
