{
    "name": "idfkit-lsp",
    "displayName": "idfkit Language Support",
    "description": "Completion, hover and signature help for Python code that uses idfkit (requires the idfkit-lsp Python package), plus semantic highlighting, diagnostics, completion, hover and go-to-definition for EnergyPlus IDF files.",
    "version": "0.4.0",
    "publisher": "idfkit",
    "license": "MIT",
    "homepage": "https://github.com/idfkit/idfkit-lsp#readme",
    "bugs": {
        "url": "https://github.com/idfkit/idfkit-lsp/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/idfkit/idfkit-lsp"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "energyplus",
        "idf",
        "idfkit",
        "building energy",
        "building simulation",
        "energy modeling",
        "language server",
        "lsp",
        "python"
    ],
    "activationEvents": [
        "onLanguage:python",
        "onLanguage:idf"
    ],
    "main": "./client/dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "idf",
                "aliases": [
                    "EnergyPlus Input Data File",
                    "IDF"
                ],
                "extensions": [
                    ".idf"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "idfkit Language Server",
            "properties": {
                "idfkitLsp.pythonPath": {
                    "type": "string",
                    "default": "python3",
                    "description": "Path to the Python interpreter that has idfkit and idfkit-lsp installed. This is what runs the source server."
                },
                "idfkitLsp.nodePath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to a Node runtime for the model server. Leave empty to use the editor's own runtime, which needs no separate install."
                },
                "idfkitLsp.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the language servers"
                }
            }
        },
        "commands": [
            {
                "command": "idfkitLsp.restartServer",
                "title": "idfkit: Restart Language Servers"
            },
            {
                "command": "idfkitLsp.openDocumentation",
                "title": "idfkit: Open Documentation"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm --prefix client ci && npm run compile -- --sourcemap=external && npm --prefix model-server ci --include=dev && npm run compile:model-server -- -- --sourcemap=external",
        "compile": "esbuild client/src/extension.ts --bundle --outfile=client/dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
        "compile:model-server": "npm --prefix model-server run build",
        "watch": "esbuild client/src/extension.ts --bundle --outfile=client/dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap --watch"
    },
    "devDependencies": {
        "@types/vscode": "1.90.0",
        "@vscode/vsce": "3.9.2",
        "esbuild": "^0.27.3",
        "typescript": "^5.0.0"
    }
}
